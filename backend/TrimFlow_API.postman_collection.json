{
	"info": {
		"_postman_id": "trimflow-barbershop-api",
		"name": "TrimFlow Barbershop API",
		"description": "Complete API collection for TrimFlow Barbershop platform.\n\n## Setup\n1. Set `base_url` variable to your server URL (default: http://localhost:5001)\n2. Register/Login to get a token — it auto-saves to `token` variable\n3. Use folders to test each module\n\n## Auth Flow\n- Register → Login → Use token in all protected routes",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5001",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "barber_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "service_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "booking_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "expense_id",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🏥 Health",
			"item": [
				{
					"name": "Ping",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/health",
							"host": ["{{base_url}}"],
							"path": ["api", "health"]
						},
						"description": "Health check endpoint. No auth required."
					}
				}
			]
		},
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const res = pm.response.json();",
									"    pm.collectionVariables.set('token', res.data.token);",
									"    pm.collectionVariables.set('user_id', res.data.user.id);",
									"    pm.test('Registration successful', () => {",
									"        pm.expect(res.success).to.be.true;",
									"        pm.expect(res.data.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register a new user. Returns JWT token.\n\n**Body:**\n- `name` (string, 2-50 chars, required)\n- `email` (string, valid email, required)\n- `password` (string, min 6 chars, required)"
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const res = pm.response.json();",
									"    pm.collectionVariables.set('token', res.data.token);",
									"    pm.collectionVariables.set('user_id', res.data.user.id);",
									"    pm.test('Login successful', () => {",
									"        pm.expect(res.success).to.be.true;",
									"        pm.expect(res.data.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with email and password. Returns JWT token.\n\n**Body:**\n- `email` (string, required)\n- `password` (string, required)"
					}
				},
				{
					"name": "Google OAuth",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/google",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "google"]
						},
						"description": "Initiates Google OAuth flow. Open in browser — redirects to Google login."
					}
				}
			]
		},
